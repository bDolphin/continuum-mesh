# Memory Daemon Configuration
# Copy this file to .env and configure as needed

# Embedding Mode: 'testing' or 'openai'
# - testing: Uses hash-based embeddings (no API key required, good for development)
# - openai: Uses OpenAI's text-embedding-3-small model (requires API key)
EMBEDDING_MODE=testing

# OpenAI API Key (only required if EMBEDDING_MODE=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Example with OpenAI enabled:
# EMBEDDING_MODE=openai
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
